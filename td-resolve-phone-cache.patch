+  // number unreachable for the whole lifetime of the process, long after the owner changed the
+  // setting. When the caller asked for a non-local lookup, ask the server again instead of
+  // trusting it. Positive entries are still served from the cache, so resolved numbers cost no
+  // extra traffic.
   auto it = resolved_phone_numbers_.find(phone_number);
-  if (it != resolved_phone_numbers_.end()) {
+  if (it != resolved_phone_numbers_.end() && (only_local || it->second.is_valid())) {
